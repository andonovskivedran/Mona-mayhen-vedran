---
import '../styles/arena.css';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Two GitHub profiles. One neon arena. Compare contribution calendars, discover your longest streak, and battle for the high score." />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <title>Mona Mayhem — GitHub Contribution Battle Arena</title>
  </head>
  <body>
    <a class="skip-link" href="#battle-form">Skip to battle</a>
    <main class="arena">
      <nav class="topbar" aria-label="Arena controls">
        <a class="wordmark" href={base} aria-label="Mona Mayhem home"><span class="pixel-mark" aria-hidden="true">M</span> MONA / MAYHEM</a>
        <div class="controls"><button id="sound-button" class="control" type="button" aria-pressed="false">Sound: OFF</button><button id="theme-button" class="control" type="button" aria-pressed="false">Theme: CLASSIC</button></div>
      </nav>
      <header class="page-header">
        <p class="eyebrow"><span class="status-dot"></span> GITHUB CONTRIBUTION BATTLE ARENA</p>
        <h1>CODE. COMMIT.<br /><span>CONQUER.</span></h1>
        <p class="intro">Your commits tell a story. Let's see who owns the arena.</p>
        <div class="edition" aria-hidden="true">[ TWO PLAYERS · ONE HIGH SCORE ]</div>
      </header>
      <section class="setup-panel" aria-labelledby="setup-title">
        <div class="panel-top"><h2 id="setup-title">CHOOSE YOUR FIGHTERS</h2><span>ROUND 01</span></div>
        <form id="battle-form" novalidate>
          <div class="players">
            <div class="player-input"><label for="player-one"><span class="player-number">P1</span> Player 1</label><div class="input-wrap"><span aria-hidden="true">@</span><input id="player-one" name="playerOne" type="text" placeholder="octocat" autocomplete="off" autocapitalize="none" spellcheck="false" maxlength="39" required /></div></div>
            <span class="input-versus" aria-hidden="true">VS</span>
            <div class="player-input"><label for="player-two"><span class="player-number purple">P2</span> Player 2</label><div class="input-wrap"><span aria-hidden="true">@</span><input id="player-two" name="playerTwo" type="text" placeholder="torvalds" autocomplete="off" autocapitalize="none" spellcheck="false" maxlength="39" required /></div></div>
          </div>
          <button id="battle-button" class="primary" type="submit">⚡ Battle!</button>
          <p class="form-hint">Enter two GitHub usernames. Press Enter to battle.</p>
        </form>
        <button id="demo-button" class="text-button" type="button">Just exploring? Try octocat vs torvalds →</button>
      </section>
      <p id="battle-status" role="status" aria-live="polite" aria-atomic="true"></p>
      <div id="winner-banner" class="winner-banner" hidden></div>
      <section id="results" aria-label="Battle results" hidden>
        <article id="player-one-result" class="result-card"></article><div class="versus" aria-hidden="true">VS</div><article id="player-two-result" class="result-card"></article>
      </section>
      <div class="share-area"><button id="share-button" class="secondary" type="button" hidden>Share Results</button><div id="share-fallback" hidden><label for="share-text">Copy your battle summary</label><textarea id="share-text" readonly rows="4"></textarea></div></div>
      <section class="history-panel" aria-labelledby="history-title"><div class="panel-top"><h2 id="history-title">RECENT BATTLES</h2><button id="clear-history" class="text-button" type="button" hidden>Clear history</button></div><ol id="history-list"></ol><p class="storage-note">Last 10 battles · saved on this device</p></section>
      <footer><span>MONA MAYHEM <span aria-hidden="true">/</span> INSERT COMMITS TO PLAY</span><span>Built with Astro &amp; GitHub</span></footer>
      <noscript><p class="no-script">Enable JavaScript to load contributions and start a battle.</p></noscript>
    </main>
    <div id="countdown" class="countdown-overlay" hidden aria-hidden="true"><span id="countdown-text"></span><span class="eyebrow">GET READY TO COMMIT</span></div>
    <script>import '../scripts/battle';</script>
  </body>
</html>
