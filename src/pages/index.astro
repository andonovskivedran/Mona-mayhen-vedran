---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Space+Mono:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<title>Mona Mayhem — GitHub Contribution Battle Arena</title>
	</head>
	<body>
		<main class="arena">
			<header class="page-header">
				<h1>Mona Mayhem</h1>
				<p>GitHub Contribution Battle Arena</p>
			</header>

			<form id="battle-form" novalidate>
				<div class="players">
					<div class="player-input">
						<label for="player-one">Player 1</label>
						<input
							id="player-one"
							name="playerOne"
							type="text"
							placeholder="GitHub username"
							autocomplete="off"
							autocapitalize="none"
							spellcheck="false"
							maxlength="39"
							required
						/>
					</div>
					<div class="player-input">
						<label for="player-two">Player 2</label>
						<input
							id="player-two"
							name="playerTwo"
							type="text"
							placeholder="GitHub username"
							autocomplete="off"
							autocapitalize="none"
							spellcheck="false"
							maxlength="39"
							required
						/>
					</div>
				</div>
				<button id="battle-button" type="submit">Battle</button>
			</form>

			<p id="battle-status" role="status" aria-live="polite"></p>

			<section id="results" aria-label="Battle results" hidden>
				<article id="player-one-result" class="result-card"></article>
				<div class="versus" aria-hidden="true">VS</div>
				<article id="player-two-result" class="result-card"></article>
			</section>
		</main>
	</body>
</html>

<style>
	:root {
		color-scheme: dark;
		font-family: 'Space Mono', monospace;
		color: #effff3;
		background: #0a0a1a;
		font-synthesis: none;
		--arcade-bg: #0a0a1a;
		--arcade-green: #5fed83;
		--arcade-purple: #8a2be2;
		--arcade-panel: #111328;
		--arcade-muted: #a7aac0;
	}

	body {
		position: relative;
		isolation: isolate;
		min-height: 100vh;
		margin: 0;
		min-width: 320px;
		background:
			radial-gradient(ellipse at 50% 0%, rgb(138 43 226 / 12%), transparent 48%),
			var(--arcade-bg);
	}

	body::before {
		position: fixed;
		z-index: 0;
		inset: 0;
		background: repeating-linear-gradient(
			to bottom,
			transparent 0,
			transparent 3px,
			rgb(0 0 0 / 3%) 4px
		);
		content: '';
		pointer-events: none;
	}

	.arena {
		position: relative;
		z-index: 1;
		width: min(100% - 2rem, 960px);
		margin: 0 auto;
		padding: 4rem 0;
	}

	.page-header {
		margin-bottom: 3rem;
		text-align: center;
	}

	h1 {
		margin: 0 0 1rem;
		color: var(--arcade-green);
		font-family: 'Press Start 2P', monospace;
		font-size: clamp(1.25rem, 5vw, 2.25rem);
		line-height: 1.6;
		text-shadow: 0 0 8px rgb(95 237 131 / 75%), 0 0 28px rgb(95 237 131 / 38%);
		animation: neon-pulse 3s ease-in-out infinite;
	}

	.page-header p {
		margin: 0;
		color: var(--arcade-muted);
		font-size: 0.9rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.players {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem;
	}

	.player-input {
		display: grid;
		gap: 0.65rem;
		animation: float-in 550ms ease-out both;
	}

	.player-input:nth-child(2) {
		animation-delay: 120ms;
	}

	label {
		color: var(--arcade-green);
		font-family: 'Press Start 2P', monospace;
		font-size: 0.65rem;
	}

	input,
	button {
		box-sizing: border-box;
		min-height: 3rem;
		padding: 0.75rem 0.9rem;
		font: inherit;
	}

	input {
		width: 100%;
		border: 1px solid rgb(95 237 131 / 48%);
		border-radius: 0.4rem;
		outline: none;
		background: #0d1020;
		color: #effff3;
		box-shadow: inset 0 0 14px rgb(95 237 131 / 5%);
		transition: border-color 180ms ease, box-shadow 180ms ease;
	}

	input::placeholder {
		color: #737891;
	}

	input:focus-visible {
		border-color: var(--arcade-green);
		box-shadow: 0 0 0 3px rgb(95 237 131 / 14%), 0 0 18px rgb(95 237 131 / 18%);
	}

	button {
		display: block;
		min-width: 12rem;
		margin: 1.5rem auto 0;
		border: 1px solid var(--arcade-green);
		border-radius: 0.4rem;
		background: linear-gradient(110deg, rgb(95 237 131 / 12%), rgb(138 43 226 / 20%));
		color: var(--arcade-green);
		font-family: 'Press Start 2P', monospace;
		font-size: 0.7rem;
		cursor: pointer;
		box-shadow: 0 0 16px rgb(95 237 131 / 15%);
		transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease;
	}

	button:hover:not(:disabled) {
		transform: translateY(-2px);
		background: linear-gradient(110deg, rgb(95 237 131 / 22%), rgb(138 43 226 / 32%));
		box-shadow: 0 0 24px rgb(95 237 131 / 32%);
	}

	button:focus-visible {
		outline: 2px solid var(--arcade-purple);
		outline-offset: 4px;
	}

	button:disabled {
		cursor: wait;
		opacity: 0.7;
	}

	#battle-status {
		min-height: 1.5rem;
		margin: 1.5rem 0;
		text-align: center;
		color: var(--arcade-green);
		font-size: 0.9rem;
	}

	#battle-status[data-loading] {
		animation: loading-shift 1.5s ease-in-out infinite alternate;
	}

	#battle-status[data-error] {
		color: #ff8295;
	}

	#results {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		gap: 1.25rem;
	}

	.result-card {
		position: relative;
		overflow: hidden;
		min-width: 0;
		padding: 1.25rem;
		border: 1px solid rgb(138 43 226 / 55%);
		border-radius: 0.55rem;
		background: linear-gradient(145deg, rgb(17 19 40 / 96%), rgb(12 13 29 / 96%));
		box-shadow: 0 0 20px rgb(138 43 226 / 10%);
	}

	.result-card::before {
		position: absolute;
		inset: 0;
		transform: translateX(-120%);
		background: linear-gradient(110deg, transparent 25%, rgb(255 255 255 / 7%) 50%, transparent 75%);
		content: '';
		pointer-events: none;
		animation: card-shimmer 7s ease-in-out infinite;
	}

	.result-card h2 {
		margin: 0 0 1rem;
		overflow-wrap: anywhere;
		color: var(--arcade-green);
		font-family: 'Press Start 2P', monospace;
		font-size: 0.8rem;
		line-height: 1.7;
		text-shadow: 0 0 10px rgb(95 237 131 / 35%);
	}

	.result-card > p:not(.result-meta) {
		color: #f7f5ff;
		font-size: 1rem;
		font-weight: 700;
	}

	.result-meta {
		color: var(--arcade-muted);
		font-size: 0.9rem;
	}

	.contribution-grid {
		position: relative;
		z-index: 1;
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: 0.72rem;
		grid-template-rows: repeat(7, 0.72rem);
		gap: 0.22rem;
		overflow-x: auto;
		padding: 0.45rem 0.2rem;
	}

	.contribution-day {
		width: 0.72rem;
		height: 0.72rem;
		border-radius: 0.18rem;
		outline: 1px solid rgb(255 255 255 / 5%);
		transition: transform 140ms ease, box-shadow 140ms ease;
	}

	.contribution-day:hover {
		z-index: 2;
		transform: scale(1.45);
		box-shadow: 0 0 10px currentcolor, 0 0 18px currentcolor;
	}

	.versus {
		display: grid;
		width: 3.75rem;
		aspect-ratio: 1;
		place-items: center;
		border: 1px solid rgb(138 43 226 / 70%);
		border-radius: 50%;
		background: linear-gradient(135deg, rgb(95 237 131 / 18%), rgb(138 43 226 / 35%));
		color: white;
		font-family: 'Press Start 2P', monospace;
		font-size: 0.8rem;
		text-shadow: 0 0 10px white;
		box-shadow: 0 0 16px rgb(138 43 226 / 30%);
		background-size: 200% 200%;
		animation: versus-shift 4s ease-in-out infinite alternate;
	}

	@media (max-width: 640px) {
		.arena {
			padding-top: 2.5rem;
		}

		.players {
			grid-template-columns: minmax(0, 1fr);
		}

		#results {
			grid-template-columns: minmax(0, 1fr);
		}

		.versus {
			width: 3rem;
			margin: 0 auto;
			font-size: 0.65rem;
		}

		.result-card {
			padding: 1rem;
		}
	}

	@keyframes neon-pulse {
		0%,
		100% {
			text-shadow: 0 0 7px rgb(95 237 131 / 60%), 0 0 20px rgb(95 237 131 / 28%);
		}
		50% {
			text-shadow: 0 0 12px rgb(95 237 131 / 90%), 0 0 34px rgb(95 237 131 / 48%);
		}
	}

	@keyframes float-in {
		from {
			transform: translateY(12px);
			opacity: 0;
		}
		to {
			transform: translateY(0);
			opacity: 1;
		}
	}

	@keyframes loading-shift {
		from {
			color: var(--arcade-green);
			text-shadow: 0 0 8px rgb(95 237 131 / 45%);
		}
		to {
			color: #c28aff;
			text-shadow: 0 0 10px rgb(138 43 226 / 65%);
		}
	}

	@keyframes card-shimmer {
		0%,
		65% {
			transform: translateX(-120%);
		}
		85%,
		100% {
			transform: translateX(120%);
		}
	}

	@keyframes versus-shift {
		from {
			background-position: 0% 50%;
			box-shadow: 0 0 14px rgb(95 237 131 / 24%);
		}
		to {
			background-position: 100% 50%;
			box-shadow: 0 0 22px rgb(138 43 226 / 48%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			scroll-behavior: auto !important;
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>

<script>
	interface ContributionDay {
		weekday: number;
		count: number;
		level: number;
	}

	interface ContributionWeek {
		first_day: string;
		contribution_days: ContributionDay[];
	}

	interface ContributionData {
		from: string;
		to: string;
		total_contributions: number;
		colors_full: string[];
		weeks: ContributionWeek[];
	}

	const USERNAME_PATTERN = /^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$/;
	const FALLBACK_COLORS = ['#ebedf0', '#9be9a8', '#40c463', '#30a14e', '#216e39'];
	const form = document.querySelector<HTMLFormElement>('#battle-form');
	const playerOneInput = document.querySelector<HTMLInputElement>('#player-one');
	const playerTwoInput = document.querySelector<HTMLInputElement>('#player-two');
	const battleButton = document.querySelector<HTMLButtonElement>('#battle-button');
	const status = document.querySelector<HTMLParagraphElement>('#battle-status');
	const results = document.querySelector<HTMLElement>('#results');
	const playerOneResult = document.querySelector<HTMLElement>('#player-one-result');
	const playerTwoResult = document.querySelector<HTMLElement>('#player-two-result');

	function isContributionData(value: unknown): value is ContributionData {
		if (!value || typeof value !== 'object') {
			return false;
		}

		const data = value as Partial<ContributionData>;
		return (
			typeof data.from === 'string' &&
			typeof data.to === 'string' &&
			typeof data.total_contributions === 'number' &&
			Array.isArray(data.colors_full) &&
			Array.isArray(data.weeks)
		);
	}

	async function fetchContributions(username: string): Promise<ContributionData> {
		const response = await fetch(`/api/contributions/${encodeURIComponent(username)}`);
		const body: unknown = await response.json();

		if (!response.ok) {
			const message =
				body && typeof body === 'object' && 'error' in body && typeof body.error === 'string'
					? body.error
					: 'Unable to load contribution data.';
			throw new Error(message);
		}

		if (!isContributionData(body)) {
			throw new Error('The contribution response was not in the expected format.');
		}

		return body;
	}

	function formatDate(date: string): string {
		const parsed = new Date(`${date}T00:00:00Z`);
		if (Number.isNaN(parsed.getTime())) {
			return date;
		}
		return new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeZone: 'UTC' }).format(parsed);
	}

	function renderPlayer(container: HTMLElement, username: string, data: ContributionData): void {
		const heading = document.createElement('h2');
		heading.textContent = username;

		const summary = document.createElement('p');
		summary.textContent = `${data.total_contributions.toLocaleString()} contributions`;

		const dateRange = document.createElement('p');
		dateRange.className = 'result-meta';
		dateRange.textContent = `${formatDate(data.from)} – ${formatDate(data.to)}`;

		const grid = document.createElement('div');
		grid.className = 'contribution-grid';
		grid.setAttribute('role', 'img');
		grid.setAttribute('aria-label', `${username}'s contribution activity by day`);

		for (const week of data.weeks) {
			for (const day of week.contribution_days) {
				const cell = document.createElement('span');
				const weekStart = new Date(`${week.first_day}T00:00:00Z`);
				if (!Number.isNaN(weekStart.getTime())) {
					weekStart.setUTCDate(weekStart.getUTCDate() + day.weekday);
				}
				const dayDate = Number.isNaN(weekStart.getTime())
					? week.first_day
					: weekStart.toISOString().slice(0, 10);
				const color = data.colors_full[day.level] ?? FALLBACK_COLORS[day.level] ?? FALLBACK_COLORS[0];

				cell.className = 'contribution-day';
				cell.style.backgroundColor = /^#[\da-f]{6}$/i.test(color) ? color : FALLBACK_COLORS[0];
				cell.title = `${day.count} contributions on ${dayDate}`;
				grid.append(cell);
			}
		}

		container.replaceChildren(heading, summary, dateRange, grid);
	}

	if (
		form &&
		playerOneInput &&
		playerTwoInput &&
		battleButton &&
		status &&
		results &&
		playerOneResult &&
		playerTwoResult
	) {
		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			status.removeAttribute('data-error');

			const usernames = [playerOneInput.value.trim(), playerTwoInput.value.trim()];
			const invalidInput = usernames.find((username) => !USERNAME_PATTERN.test(username));
			if (invalidInput !== undefined) {
				status.textContent = 'Enter two valid GitHub usernames to start the battle.';
				status.setAttribute('data-error', '');
				results.hidden = true;
				return;
			}

			battleButton.disabled = true;
			status.textContent = 'Loading contribution data…';
			status.setAttribute('data-loading', '');
			results.hidden = true;

			try {
				const [playerOneData, playerTwoData] = await Promise.all(
					usernames.map((username) => fetchContributions(username)),
				);
				renderPlayer(playerOneResult, usernames[0], playerOneData);
				renderPlayer(playerTwoResult, usernames[1], playerTwoData);
				results.hidden = false;
				status.textContent = 'Battle data loaded.';
				status.removeAttribute('data-loading');
			} catch (error) {
				status.textContent =
					error instanceof Error ? error.message : 'Unable to load contribution data.';
				status.setAttribute('data-error', '');
			} finally {
				status.removeAttribute('data-loading');
				battleButton.disabled = false;
			}
		});
	}
</script>
